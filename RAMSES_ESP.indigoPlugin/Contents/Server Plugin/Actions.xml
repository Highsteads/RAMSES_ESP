<?xml version="1.0"?>
<Actions>

	<!-- Set a zone's temperature for a number of minutes (a temporary override): when
	     the time runs out, Evohome puts the zone back on its own timetable by itself. -->
	<Action id="setTemporarySetpoint" deviceFilter="self.ramsesZoneThermostat" uiPath="DeviceActions">
		<Name>Set Temperature for a While</Name>
		<CallbackMethod>action_set_temporary_setpoint</CallbackMethod>
		<ConfigUI>
			<Field id="setpoint" type="textfield" defaultValue="20">
				<Label>Temperature (degrees C):</Label>
			</Field>
			<Field id="minutes" type="textfield" defaultValue="120">
				<Label>For how many minutes:</Label>
			</Field>
			<Field id="until" type="textfield" defaultValue="">
				<Label>Or until (YYYY-MM-DD HH:MM):</Label>
			</Field>
			<Field id="help" type="label" fontSize="small" alignWithControl="true">
				<Label>Between 10 minutes and 24 hours, or until a date and time up to a year ahead, which wins when filled in. When the time runs out, Evohome puts the zone back on its own timetable. Useful for an automation: if Indigo stops, the house goes back to the timetable instead of holding this temperature for ever.</Label>
			</Field>
		</ConfigUI>
	</Action>

	<!-- Read every zone's timetable from the Evohome controller now (1.13.0). -->
	<Action id="readTimetables" uiPath="PluginActions">
		<Name>Read Evohome Timetables Now</Name>
		<CallbackMethod>action_read_timetables</CallbackMethod>
	</Action>

	<!-- Request immediate zone update from controller.
	     The setZoneSetpoint custom action has been replaced by Indigo's built-in
	     thermostat Set Heat Setpoint action (via actionControlThermostat callback). -->
	<Action id="requestZoneUpdate" uiPath="PluginActions">
		<Name>Request Zone Update</Name>
		<CallbackMethod>action_request_zone_update</CallbackMethod>
		<ConfigUI>
			<Field id="actionInfo" type="label" fontSize="small" alignWithControl="true">
				<Label>Sends an RQ 30C9 message to request current zone temperatures
from the Evohome controller. Requires gateway ID to be discovered first.</Label>
			</Field>
		</ConfigUI>
	</Action>

</Actions>
